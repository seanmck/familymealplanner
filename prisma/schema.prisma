// Prisma schema for FamilyTable meal planning app

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// Authentication & User Management
// ============================================================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String?   // Optional for OAuth-only users
  name           String?
  image          String?   // Profile photo from OAuth providers
  emailVerified  DateTime? // OAuth email verification status
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  householdId              String?
  household                Household?              @relation(fields: [householdId], references: [id], onDelete: SetNull)
  sessions                 Session[]
  accounts                 Account[]
  googleCalendarConnection GoogleCalendarSettings? @relation("CalendarConnectedUser")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  // "oauth" or "oidc"
  provider          String  // "google", "credentials", etc.
  providerAccountId String  // Provider's unique user ID
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?    // Unix timestamp when access_token expires
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                  User[]
  recipes                Recipe[]
  familyMembers          FamilyMember[]
  mealPlans              MealPlan[]
  pantryStaples          PantryStaple[]
  apiTokens              ApiToken[]
  googleCalendarSettings GoogleCalendarSettings?
}

// ============================================================================
// API Tokens (for MCP/CLI access)
// ============================================================================

model ApiToken {
  id          String    @id @default(cuid())
  name        String    // User-friendly name, e.g., "Claude MCP Access"
  token       String    @unique // Hashed token
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  // Relations
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

// ============================================================================
// Google Calendar Integration
// ============================================================================

model GoogleCalendarSettings {
  id              String   @id @default(cuid())
  householdId     String   @unique
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // The user whose Google account provides calendar access
  connectedUserId String?  @unique
  connectedUser   User?    @relation("CalendarConnectedUser", fields: [connectedUserId], references: [id], onDelete: SetNull)

  // Calendar configuration
  calendarIds        String[]  @default(["primary"]) // Selected calendar IDs to display
  availableCalendars Json?     // Cached list of user's accessible calendars
  showOnPlanner      Boolean   @default(true)        // Toggle visibility on planner

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// Recipe Management
// ============================================================================

enum RecipeType {
  MAIN
  SIDE
}

model Recipe {
  id              String     @id @default(cuid())
  title           String
  description     String?
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  servings        Int        @default(4)
  instructions    String     @db.Text
  notes           String?    @db.Text // User notes (tips, variations, etc.)
  imageUrl        String?
  sourceUrl       String?    // Original URL if imported from external site
  tags            String[]   @default([])
  type            RecipeType @default(MAIN)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  householdId        String
  household          Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredients        Ingredient[]
  ratings            RecipeRating[]
  plannedMealRecipes PlannedMealRecipe[]

  @@index([householdId])
  @@index([title])
  @@index([type])
}

model Ingredient {
  id        String   @id @default(cuid())
  name      String
  quantity  Decimal? @db.Decimal(10, 3)
  unit      String?
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  recipeId     String
  recipe       Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  groceryItems GroceryItem[]

  @@index([recipeId])
}

// ============================================================================
// Family Members & Ratings
// ============================================================================

enum FamilyRole {
  ADULT
  CHILD
}

model FamilyMember {
  id        String     @id @default(cuid())
  name      String
  role      FamilyRole @default(ADULT)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  householdId   String
  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ratings       RecipeRating[]
  plannedMeals  PlannedMeal[]
  lunchboxItems LunchboxItem[]

  @@index([householdId])
}

enum Rating {
  UP
  DOWN
  NEUTRAL
}

model RecipeRating {
  id        String   @id @default(cuid())
  rating    Rating
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  recipeId String
  recipe   Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  memberId String
  member   FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([recipeId, memberId])
  @@index([recipeId])
  @@index([memberId])
}

// ============================================================================
// Meal Planning
// ============================================================================

model MealPlan {
  id            String   @id @default(cuid())
  weekStartDate DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  householdId   String
  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  plannedMeals  PlannedMeal[]
  lunchboxItems LunchboxItem[]
  groceryList   GroceryList?

  @@unique([householdId, weekStartDate])
  @@index([householdId])
  @@index([weekStartDate])
}

enum MealType {
  DINNER
  LUNCH
}

model PlannedMeal {
  id               String   @id @default(cuid())
  dayOfWeek        Int // 0 = Monday, 6 = Sunday
  mealType         MealType
  placeholderTitle String? // For quick-add without recipe
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  mealPlanId     String
  mealPlan       MealPlan            @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipes        PlannedMealRecipe[]
  familyMemberId String?             // NULL = shared meal for whole family, set = personal meal
  familyMember   FamilyMember?       @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@unique([mealPlanId, dayOfWeek, mealType, familyMemberId])
  @@index([mealPlanId])
  @@index([familyMemberId])
}

model PlannedMealRecipe {
  id            String     @id @default(cuid())
  role          RecipeType // MAIN or SIDE - allows overriding recipe.type for this meal
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())

  // Relations
  plannedMealId String
  plannedMeal   PlannedMeal @relation(fields: [plannedMealId], references: [id], onDelete: Cascade)
  recipeId      String
  recipe        Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([plannedMealId, recipeId])
  @@index([plannedMealId])
  @@index([recipeId])
}

// ============================================================================
// Grocery Lists
// ============================================================================

model GroceryList {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  mealPlanId String      @unique
  mealPlan   MealPlan    @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  items      GroceryItem[]
}

model GroceryItem {
  id          String   @id @default(cuid())
  name        String
  quantity    Decimal? @db.Decimal(10, 3)
  unit        String?
  category    String?
  isChecked   Boolean  @default(false)
  isManualAdd Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  groceryListId String
  groceryList   GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  ingredientId  String? // Link to source ingredient if from recipe
  ingredient    Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([groceryListId])
  @@index([category])
}

model PantryStaple {
  id             String   @id @default(cuid())
  name           String // Normalized name (lowercase, trimmed)
  displayName    String // User-friendly display name
  createdAt      DateTime @default(now())

  // Relations
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, name])
  @@index([householdId])
}

// ============================================================================
// Lunchbox Planning (Bento-style packed lunches)
// ============================================================================

model LunchboxItem {
  id        String   @id @default(cuid())
  dayOfWeek Int      // 0 = Monday, 6 = Sunday
  category  String?  // Optional: "main", "side", "fruit", "snack", "treat"
  name      String   // "PB&J", "carrots", "apple slices"
  notes     String?  // "cut into triangles", "no crusts"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  mealPlanId     String
  mealPlan       MealPlan     @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@index([mealPlanId, familyMemberId, dayOfWeek])
  @@index([familyMemberId])
}
