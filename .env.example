# Database
# For local dev, both can point to the same database
# For production (Supabase):
#   DATABASE_URL = Transaction pooler (port 6543) with ?pgbouncer=true
#   DIRECT_URL   = Session pooler (port 5432) - used for migrations
# Example: postgresql://user:pass@host:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://familytable:familytable_dev@localhost:5434/familytable?schema=public"
DIRECT_URL="postgresql://familytable:familytable_dev@localhost:5434/familytable?schema=public"

# NextAuth v5
AUTH_SECRET="generate-a-secure-secret-for-production"
AUTH_URL="http://localhost:3000"

# Google OAuth (for Google sign-in and Calendar integration)
# Get these from: https://console.cloud.google.com/apis/credentials
# Add redirect URIs:
#   - http://localhost:3000/api/auth/callback/google (local)
#   - https://yourdomain.com/api/auth/callback/google (production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
